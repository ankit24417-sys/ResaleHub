# ==============================================================================
# ResaleHub (FranchiseExchanger) — Unified Root Environment Example
# Copy this file to `.env` in the repository root and update values as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_with_a_strong_random_secret_key

# Optional: MongoDB URI (if omitted or unreachable, backend runs in zero-config in-memory mock mode)
MONGO_URI=mongodb://127.0.0.1:27017/resalehub

# ------------------------------------------------------------------------------
# Frontend Web App Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api

